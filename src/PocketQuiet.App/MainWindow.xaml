<Window x:Class="PocketQuiet.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PocketQuiet.ico" Title="Pocket Quiet — 조용함을 자동으로" Width="1080" Height="880" MinWidth="820" MinHeight="580"
        Background="#10191E" Foreground="#EAF2EF" FontFamily="Malgun Gothic" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9BB0AE"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#23363B"/><Setter Property="Foreground" Value="#EAF2EF"/>
      <Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#15282D"/><Setter Property="Foreground" Value="#EAF2EF"/>
      <Setter Property="BorderBrush" Value="#385157"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#10231F"/></Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#19292E"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,20,0">
      <StackPanel DockPanel.Dock="Top">
        <Image Source="Assets/PocketQuiet.png" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Pocket Quiet 팬 아이콘"/>
        <TextBlock Text="Pocket" FontSize="27" FontWeight="Bold"/><TextBlock Text="Quiet" FontSize="27" FontWeight="Bold" Foreground="#8EE3B0"/>
        <TextBlock Text="조용함을 자동으로" Margin="0,12,0,30" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="●  팬 컨트롤" Foreground="#8EE3B0" FontWeight="Bold"/>
        <TextBlock Text="온도에 맞춘 최소 소음" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
        <Button Content="전력 효율 설정 ↗" Click="OpenPowerSettings" ToolTip="Windows 전원 모드를 최고 전력 효율로 바꾸면 발열을 줄이는 데 도움이 될 수 있습니다."/>
        <Button Content="소음 줄이기 ↗" Click="OpenNoiseGuide"/>
        <Button Content="사용설명서 ↗" Click="OpenManual"/><Button Content="진단 기록 ↗" Click="OpenLogs"/>
        <TextBlock Text="v0.3.0 · Windows x64" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        <TextBlock Text="인터넷 연결 없이 동작" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#284339" CornerRadius="12" Padding="12,6" Margin="12,0,0,0">
            <TextBlock x:Name="ConnectionLabel" Text="연결 중" Foreground="#9DE6B7" FontSize="12"/>
          </Border>
          <StackPanel><TextBlock Text="내 컴퓨터의 편안한 속도" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="DeviceLabel" Text="서비스에 연결하는 중…" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
        <UniformGrid Columns="3">
          <Border Style="{StaticResource Card}" Margin="0,0,10,16"><StackPanel><TextBlock Text="칩 온도" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TemperatureLabel" Text="— °C" FontSize="28" Margin="0,10,0,6"/><TextBlock Text="CPU / AMD GPU 최대" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,10,16"><StackPanel><TextBlock Text="팬 회전수" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RpmLabel" Text="— RPM" FontSize="26" Margin="0,10,0,6"/><TextBlock x:Name="DutyLabel" Text="출력 확인 중" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU 사용률" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LoadLabel" Text="— %" FontSize="28" Margin="0,10,0,6"/><TextBlock x:Name="PowerLabel" Text="전력: —" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}"><StackPanel>
          <DockPanel><TextBlock Text="온도 흐름" FontSize="15" FontWeight="Bold"/><TextBlock Text="최근 2분 · 누락 구간은 끊어서 표시" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
          <Image x:Name="Chart" Stretch="Fill" Height="140" Margin="0,12,0,8" ClipToBounds="True" SizeChanged="ChartSizeChanged"/>
          <TextBlock x:Name="ActiveLabel" Text="적용 상태 확인 중" Foreground="#8EE3B0" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ReasonLabel" Text="센서 데이터 대기 중" Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="SampleLabel" Text="최근 정상 측정: —" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="자동 조절 프리셋" FontSize="16" FontWeight="Bold"/>
          <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged" DisplayMemberPath="Label"/>
            <Button Grid.Column="1" x:Name="ApplyButton" Content="프리셋 적용" Click="Apply" Background="#94DDB0" Foreground="#0D2920" FontWeight="Bold" Margin="10,0,0,0"/>
          </Grid>
          <TextBlock x:Name="DraftLabel" Text="현재 설정과 동일" Foreground="#8EE3B0" FontSize="12" Margin="0,0,0,8"/>
          <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
          <StackPanel x:Name="AdaptivePanel" Visibility="Collapsed" Margin="0,12,0,0">
            <DockPanel><TextBlock Text="더 조용하게" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="더 시원하게" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel>
            <Slider x:Name="Preference" Minimum="-1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="PreferenceChanged" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="CurvePanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="각 점: 위 온도 °C / 아래 출력 % · 마지막 점 85 / 100" FontSize="12" Foreground="{StaticResource Muted}"/>
            <WrapPanel x:Name="CurveFields" Margin="0,8,0,8"/>
            <WrapPanel><Button x:Name="AddPointButton" Content="점 추가" Click="AddPoint"/><Button x:Name="RemovePointButton" Content="점 삭제" Click="RemovePoint"/><Button Content="기본 곡선" Click="DefaultCurve"/></WrapPanel>
          </StackPanel>
          <TextBlock x:Name="ValidationLabel" Foreground="#FFDBAE" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Image x:Name="CurvePreview" Height="110" Stretch="Fill" Margin="0,10,0,0" SizeChanged="CurveSizeChanged"/>
          <TextBlock Text="곡선은 목표 출력입니다. 감속 대기·고온 보호가 실제 출력을 조절합니다." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="소음 줄이기" FontSize="14" FontWeight="Bold"/>
          <TextBlock x:Name="NoiseLabel" Text="무소음 프리셋은 저온에서 최소 출력을 유지합니다. 팬 정지나 0dB를 보장하지 않습니다." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/>
          <TextBlock Text="저발열 전원은 CPU 부스트를 제한해 발열을 줄입니다. 고부하 성능은 낮아질 수 있습니다. 팬 프리셋과 별개로 유지됩니다." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0" FontSize="12"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="QuietPowerButton" Content="저발열 전원 적용" Click="ApplyQuietPower"/>
            <Button x:Name="RestorePowerButton" Content="기존 전원 복원" Click="RestorePower"/>
          </WrapPanel>
          <TextBlock x:Name="PowerProfileLabel" Text="전원 계획 확인 중" TextWrapping="Wrap" Foreground="#8EE3B0" FontSize="12"/>
        </StackPanel></Border>
        <Border x:Name="AlertBox" Background="#3B3027" CornerRadius="9" Padding="13" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="AlertLabel" Foreground="#FFDBAE" TextWrapping="Wrap"/></Border>
        <Border x:Name="ProtectionBox" Background="#28343B" CornerRadius="9" Padding="13" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel>
          <TextBlock x:Name="ProtectionLabel" TextWrapping="Wrap" Foreground="#D7E4ED"/>
          <Button Content="기록 확인함" Click="Acknowledge" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="0,12,0,0">
        <WrapPanel>
          <Button x:Name="RestoreButton" Content="기기 기본 자동으로 복귀" Click="Restore"/>
          <Button x:Name="ResetButton" Content="설정 초기화" Click="Reset"/>
          <Button x:Name="RetryButton" Content="연결 재초기화" Click="Retry"/>
          <Button Content="트레이로 숨기기" Click="HideToTray"/>
        </WrapPanel>
        <TextBlock x:Name="Footer" Text="닫기(X)는 트레이로 숨깁니다. 완전 종료는 트레이 메뉴에서 선택하세요." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
